# Copy to .env and fill in your values

# AI content generation
GROQ_API_KEY=your_groq_api_key_here

# Facebook publishing
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_TOKEN=your_long_lived_page_access_token_here

# X / Twitter publishing
X_BEARER_TOKEN=your_x_bearer_token_here

# Instagram publishing
IG_USER_ID=your_instagram_business_account_id_here
IG_ACCESS_TOKEN=your_instagram_access_token_here
IG_MEDIA_URL=https://images.pexels.com/photos/4386321/pexels-photo-4386321.jpeg

# Optional image source
PEXELS_API_KEY=your_pexels_api_key_here

# Optional weekly report email
REPORT_EMAIL=your@email.com
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
